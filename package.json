{
  "name": "hexo-blog-manager",
  "version": "1.0.0",
  "description": "Hexo Blog Manager - desktop GUI Hexo management tool",
  "main": "src/main/index.js",
  "scripts": {
    "start": "node ./scripts/start.js",
    "test": "node --no-warnings ./node_modules/jest/bin/jest.js --runInBand",
    "dist": "electron-builder --win",
    "test:watch": "jest --watch"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hexo-generator-search": "^2.4.3",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "electron": "^43.3.0",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.hexo.blog-manager",
    "productName": "HexoBlogManager",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "使用手册.md",
      "src/renderer/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/renderer/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
